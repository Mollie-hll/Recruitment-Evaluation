问3：def show_predictions(model, testloader, classes, num_images=10):
    device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
    model.eval()
    
    dataiter = iter(testloader)
    images, labels = next(dataiter)
    images, labels = images.to(device), labels.to(device)
    
    outputs = model(images)
    _, predicted = torch.max(outputs, 1)
    
    images = images.cpu()
    labels = labels.cpu()
    predicted = predicted.cpu()
    
    correct_indices = (predicted == labels).nonzero().flatten()
    wrong_indices = (predicted != labels).nonzero().flatten()
    plt.figure(figsize=(15, 6))
    plt.suptitle('正确分类的图片示例', fontsize=16)
    
    for i, idx in enumerate(correct_indices[:5]):  
        plt.subplot(2, 5, i+1)
        img = images[idx] / 2 + 0.5  # 反标准化回0-1范围
        img = img.numpy().transpose((1, 2, 0))
        plt.imshow(img)
        plt.title(f'True: {classes[labels[idx]]}\nPred: {classes[predicted[idx]]}')
        plt.axis('off')
    
    plt.suptitle('错误分类的图片示例', fontsize=16)
    for i, idx in enumerate(wrong_indices[:5]): 
        plt.subplot(2, 5, i+6)
        img = images[idx] / 2 + 0.5
        img = img.numpy().transpose((1, 2, 0))
        plt.imshow(img)
        plt.title(f'True: {classes[labels[idx]]}\nPred: {classes[predicted[idx]]}', color='red')
        plt.axis('off')
    
    plt.tight_layout()
    plt.savefig('predictions.png')
    plt.show()
